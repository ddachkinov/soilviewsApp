{
  "name": "soilviews",
  "version": "1.0.0",
  "description": "SoilViews - Research-backed agricultural intelligence platform for Bulgarian farmers",
  "private": true,
  "keywords": [
    "agriculture",
    "precision-farming",
    "soil-mapping",
    "sentinel-2",
    "deep-learning",
    "variable-rate-application",
    "crop-insurance",
    "bulgaria"
  ],
  "author": "SoilViews Team",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream run dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "test:e2e": "pnpm --filter web run test:e2e",
    "lint": "pnpm --recursive run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "type-check": "pnpm --recursive run type-check",
    "clean": "pnpm --recursive run clean && rm -rf node_modules",
    "prepare": "husky install",
    "docker:dev": "docker-compose -f infra/docker-compose.dev.yml up",
    "docker:test": "docker-compose -f infra/docker-compose.test.yml up --abort-on-container-exit",
    "db:migrate": "pnpm --filter api run db:migrate",
    "db:seed": "pnpm --filter api run db:seed",
    "cost:estimate": "node scripts/benchmarks/cost-estimator.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "turbo": "^1.11.2"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.3.3"
    }
  }
}
