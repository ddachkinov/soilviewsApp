# =============================================================================
# SoilViews Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Node Environment
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# -----------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=soilviews
DATABASE_USER=soilviews
DATABASE_PASSWORD=changeme
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Redis Cache
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_PORT=3000
API_HOST=localhost
API_BASE_URL=http://localhost:3000
API_CORS_ORIGIN=http://localhost:5173

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-refresh-secret-change-this
JWT_REFRESH_EXPIRATION=30d

# -----------------------------------------------------------------------------
# Object Storage (S3 / MinIO)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=soilviews-cogs
S3_REGION=eu-central-1
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Sentinel-Hub API (https://www.sentinel-hub.com/)
# -----------------------------------------------------------------------------
SENTINEL_HUB_CLIENT_ID=your-sentinel-hub-client-id
SENTINEL_HUB_CLIENT_SECRET=your-sentinel-hub-client-secret
SENTINEL_HUB_INSTANCE_ID=your-instance-id
SENTINEL_HUB_BASE_URL=https://services.sentinel-hub.com

# -----------------------------------------------------------------------------
# Machine Learning
# -----------------------------------------------------------------------------
ML_MODEL_PATH=./models/soilviews-efficientnet-b3.pth
ML_INFERENCE_ENDPOINT=http://localhost:8001/predict
ML_BATCH_SIZE=4
ML_GPU_ENABLED=false

# AWS Lambda (for serverless inference)
AWS_LAMBDA_FUNCTION_NAME=soilviews-inference
AWS_LAMBDA_REGION=eu-central-1

# -----------------------------------------------------------------------------
# Feature Flags (Unleash)
# -----------------------------------------------------------------------------
UNLEASH_URL=http://localhost:4242
UNLEASH_API_KEY=
UNLEASH_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# -----------------------------------------------------------------------------
# Bulgarian eIDAS Integration
# -----------------------------------------------------------------------------
EIDAS_ENABLED=false
EIDAS_ENTITY_ID=
EIDAS_SSO_URL=
EIDAS_CERTIFICATE_PATH=

# -----------------------------------------------------------------------------
# Email (for notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@soilviews.bg

# -----------------------------------------------------------------------------
# Web Frontend
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000
VITE_MAPBOX_ACCESS_TOKEN=
VITE_DEFAULT_MAP_CENTER_LAT=42.7339
VITE_DEFAULT_MAP_CENTER_LNG=25.4858
VITE_DEFAULT_MAP_ZOOM=7

# -----------------------------------------------------------------------------
# Ground Truth CLI
# -----------------------------------------------------------------------------
GROUND_TRUTH_API_KEY=your-api-key-for-cli-uploads

# -----------------------------------------------------------------------------
# Cost Optimization
# -----------------------------------------------------------------------------
LAMBDA_MEMORY_MB=10240
LAMBDA_TIMEOUT_SECONDS=300
LAMBDA_CONCURRENCY_LIMIT=10
S3_INTELLIGENT_TIERING_ENABLED=true

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ENABLED=true
HELMET_ENABLED=true

# -----------------------------------------------------------------------------
# GDPR Compliance
# -----------------------------------------------------------------------------
GDPR_DATA_RETENTION_DAYS=2555
GDPR_AUDIT_LOG_ENABLED=true
COOKIE_CONSENT_REQUIRED=true
